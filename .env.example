# ===== AI-Key 管理工作台 · 多 Provider 配置模板 =====
# 用法： cp .env.example .env  然后填写各平台的 Key。
# 所有值均为本地明文；.env 已被 .gitignore 忽略，不会提交进 git。

# ---------- 服务 ----------
# 工作台端口，不配置则默认 8000。多项目端口冲突时改这里，然后 ./run.sh restart
#TPH_PORT=8000

# ---------- 存储 ----------
# TPH_REDIS_URL=redis://localhost:6379/0
# TPH_DATA_DIR=

# ---------- 阿里云百炼 (DashScope) ----------
# 业务空间（可在百炼控制台查看，形如 llm-xxxxxxxxxxxx）
BAILIAN_WORKSPACE_ID=
# 通用 DashScope API Key（在百炼控制台申请）
BAILIAN_API_KEY=
# token-plan 专属 base_url（一般无需改）
BAILIAN_TOKENPLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com

# ---------- 智谱 GLM (bigmodel.cn) ----------
# 智谱开放平台 API Key；若开通了 Code Plan 订阅，可在此配置
ZHIPU_API_KEY=
# 智谱 Code Plan 专用 Key（用于查 Code Plan 用量，一般不同于上面的通用 Key）
ZHIPU_TOKENPLAN_API_KEY=

# ---------- OpenAI ----------
OPENAI_API_KEY=

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=

# ---------- Kimi (Moonshot) ----------
KIMI_API_KEY=

# ---------- xAI Grok 管理 API ----------
# 管理密钥不同于推理 API Key；只需配置具备用量查询权限的密钥
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=

# ---------- 多账号：仅首次导入，后续在页面编辑 ----------
# 相同变量加 _2、_3 等数字即可添加更多账号；每个槽位只导入一次。
# 页面修改/删除后，重启不会覆盖或恢复。已有账号更换密钥请在页面编辑。
# OPENAI_API_KEY_2=
# OPENAI_API_KEY_2_NAME=我的第二个 OpenAI 账号
# BAILIAN_TOKENPLAN_API_KEY=
# BAILIAN_TOKENPLAN_API_KEY_NAME=公司 Token Plan
# BAILIAN_TOKENPLAN_API_KEY_2=
# ZHIPU_TOKENPLAN_API_KEY_2=
# ZHIPU_TOKENPLAN_API_KEY_2_NAME=第二个 Code Plan
# XAI_MANAGEMENT_KEY_2=
# XAI_MANAGEMENT_KEY_2_TEAM_ID=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# 无 API Key 的会员账号：直接在「账号管理」添加「会员 · 手工记录」。
